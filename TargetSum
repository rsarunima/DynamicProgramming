public class TargetSum {

	public static void main(String[] args) {
		
		int[] nums= {1,1,2,3};
		
		int sum=1;
		
		int n= nums.length;
		
		int arrsum=0;
		
		for(int i=0;i<n;i++) {
			
			arrsum+=nums[i];
		}
		
		int s=(sum+ arrsum)/2;
		
		int count= countOfSubset(nums,n,s);
		
		System.out.print(count);

	}

	private static int countOfSubset(int[] nums, int n, int sum) {

		int[][] t= new int[n+1][sum+1];
		
		for(int i=0;i<=n;i++) {
			for(int j=0;j<=sum;j++) {
				
				if(i==0) {
					
					t[i][j]=0;
				}
				if(j==0) {
					t[i][j]=1;
				}
			}
		}
		
		for(int i=1;i<=n;i++) {
			for(int j=1;j<=sum;j++) {
				
				if(nums[i-1]<=j) {
					
					t[i][j]=t[i-1][j] + t[i-1][j-nums[i-1]];
				}else {
					
					t[i][j]=t[i-1][j];
				}
				
				
			}
			}
		return t[n][sum];
	}

}
