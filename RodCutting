public class RodCutting {

	public static void main(String[] args) {
		
		int rodlength=8;
		
		int[] price= {1,5,8,9,10,17,17,20};
		
		int max_profit=rodCutting(price,rodlength);
		
		System.out.print(max_profit);

	}

	private static int rodCutting(int[] price, int rodlength) {

		int[][] t= new int[rodlength+1][rodlength+1];
		
		int[] length =new int[rodlength];
		
		for(int i=0;i<rodlength;i++) {
			
			length[i]= i+1;
		}
		
		for(int i=0;i<=rodlength;i++) {
			
			for(int j=0;j<=rodlength;j++) {
				
				if(i==0 || j==0) {
					
					t[i][j]=0;
				}
			}
		}
		
		for(int i=1;i<=rodlength;i++) {
			
			for(int j=1;j<=rodlength;j++) {
				
				if(length[i-1]<=j) {
					
					t[i][j]= Math.max(price[i-1]+t[i][j-length[i-1]], t[i-1][j]);
				}else {
					
					t[i][j]=t[i-1][j];
				}


				
			}
			}
		
		return t[rodlength][rodlength];
	}

}
