public class EqualSumPartition {
	
	static boolean[][] t;

	public static void main(String[] args) {
		
		int[]  arr= {2,5,11,5};
		
	    int n=arr.length;
	    
	    int sum=0;
	    
	    for(int i=0;i<n;i++) {
	    	sum+=arr[i];
	    }
	    
	    Boolean ans=equalSumPartition(arr,sum,n);
	    
	    System.out.print(ans);

	}

	private static Boolean equalSumPartition(int[] arr, int sum, int n) {
		
		if(sum%2!=0) {
			
			return false; 
		
		}
		   else {
			
			   return subsetSum(arr,sum/2,n);
			
		}
		
		
		
		

	}

	private static Boolean subsetSum(int[] arr, int sum, int n) {
		
		t=new boolean[n+1][sum+1];
		
		for(int i=0;i<=n;i++) {
			
			for(int j=0;j<=sum;j++) {
				
				if(i==0) {
					t[i][j]= false;
				}
				
				if(j==0) {
					
					t[i][j]=true;
				}
			}
		}
		
       for(int i=1;i<=n;i++) {
			
			for(int j=1;j<=sum;j++) {
				
				if(arr[i-1]<=j) {
				   
					t[i][j]= t[i-1][j-arr[i-1]] || t[i-1][j];
				
				
				}else {
					
					t[i][j]=t[i-1][j];
				}
				}
       }
		
		
		return t[n][sum];
	}

}
