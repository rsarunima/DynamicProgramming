import java.util.Arrays;

public class KnapSack {
	
	static	int[][] t;

	public static void main(String[] args) {
		
		int capacity=7;
		int quantity=4;
		int[] wt= {1,3,4,5};
		int[] val= {1,4,5,7};
		
		t = new int[quantity + 1][capacity + 1];
        
		for(int i=0;i<= quantity;i++) {
			for(int j=0;j<=capacity;j++) {
				
				if(i==0 || j==0) {
					t[i][j]=0;
				}
			}
			
		}
		
		int max_profit=knapsack(wt,val,capacity,quantity);
		
		System.out.print(max_profit);

	}

private static int knapsack(int[] wt, int[] val, int capacity, int n){
		
		
            for(int i=1;i<=n;i++) {
			
            	for(int j=1;j<=capacity;j++) {
		
            		if(wt[i-1]<=j) {
            			
            			t[i][j]= Math.max(val[i-1]+t[i-1][j-wt[i-1]],
    					                           t[i-1][j]);
            		}  else t[i][j]=t[i-1][j];

		      }
			}
		
		  return t[n][capacity];	
		
	}

}

